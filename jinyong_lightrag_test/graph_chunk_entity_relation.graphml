  <graph edgedefault="undirected">
    <node id="Goujian">
      <data key="d0">Goujian</data>
      <data key="d1">person</data>
      <data key="d2">Goujian is the King of Yue who employed Fan Li and Wen Zhong as ministers and later adopted strategies to defeat Wu.&lt;SEP&gt;Goujian is the King of Yue who strategizes against Wu Zixu and reflects on his actions.&lt;SEP&gt;Goujian is the King of Yue, determined to overcome challenges and seek revenge against Wu, demonstrating resolve and decisiveness.</data>
      <data key="d3">chunk-c6f4631a6bc7286dd9560f06b9845d9e&lt;SEP&gt;chunk-3b2a680eed881fd86d938031d895d21e&lt;SEP&gt;chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777374824</data>
      <data key="d6" />
    </node>
    <node id="Fan Li">
      <data key="d0">Fan Li</data>
      <data key="d1">person</data>
      <data key="d2">Fan Li is a notable figure with unique behavior and insightful perspectives, who collaborated with Wen Zhong and served as a minister in Yue.&lt;SEP&gt;Fan Li is an advisor to Goujian who provides insights into Wu Zixu's strategies and actions.&lt;SEP&gt;Fan Li is a strategist from Yue who played a role in sending Xi Shi to Wu and is deeply affected by her absence.&lt;SEP&gt;Fan Li is a minister of Yue, known for his intelligence, resourcefulness, and unique personality, often referred to as "Fan Madman."&lt;SEP&gt;Fan Li is a kind and considerate man who shows care for A Qing and her mother, offering them support and expressing interest in A Qing's unique skills.</data>
      <data key="d3">chunk-c6f4631a6bc7286dd9560f06b9845d9e&lt;SEP&gt;chunk-3b2a680eed881fd86d938031d895d21e&lt;SEP&gt;chunk-9f3e590b3ab7f94ee3770d3739196401&lt;SEP&gt;chunk-2a72fd2ce03a23a58c65d98d2258f3e1&lt;SEP&gt;chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777374824</data>
      <data key="d6" />
    </node>
    <node id="Wenzhong">
      <data key="d0">Wenzhong</data>
      <data key="d1">person</data>
      <data key="d2">Wenzhong is a county magistrate who values unique perspectives and collaborates with Fan Li on state matters.</data>
      <data key="d3">chunk-c6f4631a6bc7286dd9560f06b9845d9e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777374824</data>
      <data key="d6" />
    </node>
    <node id="Fuchai">
      <data key="d0">Fuchai</data>
      <data key="d1">person</data>
      <data key="d2">Fuchai is the King of Wu who ignored loyal advice and was ultimately defeated by Yue.&lt;SEP&gt;Fuchai is the King of Wu, whose warriors and strategies are considered formidable by Yue.</data>
      <data key="d3">chunk-c6f4631a6bc7286dd9560f06b9845d9e&lt;SEP&gt;chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777374824</data>
      <data key="d6" />
    </node>
    <node id="The Sword">
      <data key="d0">The Sword</data>
      <data key="d1">artifact</data>
      <data key="d2">The Sword is a thin but incredibly sharp weapon capable of cutting through objects with ease, symbolizing power and precision.</data>
      <data key="d3">chunk-c6f4631a6bc7286dd9560f06b9845d9e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777374824</data>
      <data key="d6" />
    </node>
    <node id="Eight Green-Clad Swordsmen">
      <data key="d0">Eight Green-Clad Swordsmen</data>
      <data key="d1">person</data>
      <data key="d2">The Eight Green-Clad Swordsmen are skilled warriors from Wu who demonstrate the sharpness of the sword and their martial prowess.</data>
      <data key="d3">chunk-c6f4631a6bc7286dd9560f06b9845d9e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777374824</data>
