    <node id="Xianshi">
      <data key="d0">Xianshi</data>
      <data key="d1">person</data>
      <data key="d2">Xianshi is a master who originally forged three treasured swords for the King of Chu.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375934</data>
      <data key="d6" />
    </node>
    <node id="King Of Chu">
      <data key="d0">King Of Chu</data>
      <data key="d1">person</data>
      <data key="d2">The King of Chu is the ruler who treasured three swords forged by Xianshi and gifted one to Feng Shixiong.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375934</data>
      <data key="d6" />
    </node>
    <node id="Longyuan">
      <data key="d0">Longyuan</data>
      <data key="d1">artifact</data>
      <data key="d2">Longyuan is one of the three swords forged by Xianshi for the King of Chu.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375935</data>
      <data key="d6" />
    </node>
    <node id="Taia">
      <data key="d0">Taia</data>
      <data key="d1">artifact</data>
      <data key="d2">Taia is one of the three swords forged by Xianshi for the King of Chu.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375936</data>
      <data key="d6" />
    </node>
    <node id="Gongbu">
      <data key="d0">Gongbu</data>
      <data key="d1">artifact</data>
      <data key="d2">Gongbu is one of the three swords forged by Xianshi for the King of Chu.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375936</data>
      <data key="d6" />
    </node>
    <node id="Feng Shixiong">
      <data key="d0">Feng Shixiong</data>
      <data key="d1">person</data>
      <data key="d2">Feng Shixiong is a master who came into possession of the Gongbu sword through transfer and was a disciple linked with Xianshi.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375937</data>
      <data key="d6" />
    </node>
    <node id="Goujian">
      <data key="d0">Goujian</data>
      <data key="d1">person</data>
      <data key="d2">Goujian is a figure discussing the history and significance of the treasured swords and characters involved.&lt;SEP&gt;Goujian is a king who acknowledges the skill and insight of others and shows anger towards enemies.&lt;SEP&gt;Goujian is the King of Yue, discussing swordsmiths and commissioning swords.&lt;SEP&gt;Goujian is a king who led the Yue army in a campaign against Wu.&lt;SEP&gt;Goujian is the leader who initiated the military campaign against Wu three years later.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e&lt;SEP&gt;chunk-e93cef7b7f368309937f9f274b9ad084&lt;SEP&gt;chunk-2a72fd2ce03a23a58c65d98d2258f3e1&lt;SEP&gt;chunk-f89960ee186e8b69358a7a5c384a3ee9&lt;SEP&gt;chunk-9f20b87683fe0cc8608a321ff18feb71</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375937</data>
      <data key="d6" />
    </node>
    <node id="Xue Zhu">
      <data key="d0">Xue Zhu</data>
      <data key="d1">person</data>
      <data key="d2">Xue Zhu is a character reporting conversations and events regarding the swords, Feng Shixiong, and Wu general Wu Zixu.&lt;SEP&gt;Xue Zhu is a disciple of Ou Yezi residing in Yue.&lt;SEP&gt;Xue Zhu is tasked by Fan Li to oversee artisan production of many sharp swords.&lt;SEP&gt;Xue Zhu was appointed by Fan Li to oversee skilled craftsmen in forging countless sharp swords.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e&lt;SEP&gt;chunk-e93cef7b7f368309937f9f274b9ad084&lt;SEP&gt;chunk-f89960ee186e8b69358a7a5c384a3ee9&lt;SEP&gt;chunk-9f20b87683fe0cc8608a321ff18feb71</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375938</data>
      <data key="d6" />
    </node>
    <node id="Wu Zixu">
      <data key="d0">Wu Zixu</data>
      <data key="d1">person</data>
      <data key="d2">Wu Zixu is a Wu state general who retrieved the Gongbu sword from the tomb of King Ping of Chu and used political influence to gift it to Feng Shixiong.&lt;SEP&gt;Wu Zixu is a talented and reformist advisor in the State of Wu, highly respected for his policies and military insights.&lt;SEP&gt;Wu Zixu is a commander who arranges gifts to summon a person to support Feng Shige in forging swords and has military control over Xishan.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e&lt;SEP&gt;chunk-9f3e590b3ab7f94ee3770d3739196401&lt;SEP&gt;chunk-2a72fd2ce03a23a58c65d98d2258f3e1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375938</data>
      <data key="d6" />
    </node>
    <node id="King Ping Of Chu">
      <data key="d0">King Ping Of Chu</data>
      <data key="d1">person</data>
      <data key="d2">King Ping of Chu is a ruler whose coffin was desecrated by Wu Zixu, leading to the discovery of the Gongbu sword.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375939</data>
      <data key="d6" />
    </node>
    <node id="Wu Kingdom">
      <data key="d0">Wu Kingdom</data>
      <data key="d1">location</data>
      <data key="d2">The Wu Kingdom is the state involved in conflict with Chu, where Wu Zixu served as a high-ranking official and manipulated Feng Shixiong.&lt;SEP&gt;Wu Kingdom is a state mentioned as possessing some of Ou Yezi’s swords and being the current residence of Feng Huzi.&lt;SEP&gt;Wu Kingdom is the rival kingdom defeated by Yue warriors trained by Bai Gonggong’s swordsmanship.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e&lt;SEP&gt;chunk-bb8a415d6907f0cafb86835c412854f7&lt;SEP&gt;chunk-9f20b87683fe0cc8608a321ff18feb71&lt;SEP&gt;chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375940</data>
      <data key="d6" />
    </node>
    <node id="Wu General">
      <data key="d0">Wu General</data>
      <data key="d1">person</data>
      <data key="d2">Wu General refers generally to the military leaders of the Wu Kingdom, including Wu Zixu.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375940</data>
      <data key="d6" />
    </node>
    <node id="Ganjiang">
      <data key="d0">Ganjiang</data>
      <data key="d1">person</data>
      <data key="d2">Ganjiang is a famous swordsmith who previously forged swords but died in the process of forging a treasured sword.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375941</data>
      <data key="d6" />
    </node>
    <node id="Moye">
      <data key="d0">Moye</data>
      <data key="d1">person</data>
      <data key="d2">Moye is the spouse or counterpart of Ganjiang associated with the forging of treasured swords.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375941</data>
      <data key="d6" />
    </node>
    <node id="Woodun Mountain">
      <data key="d0">Woodun Mountain</data>
      <data key="d1">location</data>
      <data key="d2">Woodun Mountain is the location of the sword forging workshop where Feng Shixiong and Wu Zixu conducted mass sword making.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375941</data>
      <data key="d6" />
    </node>
    <node id="Sword Forging Workshop">
      <data key="d0">Sword Forging Workshop</data>
      <data key="d1">location</data>
      <data key="d2">The workshop on Woodun Mountain where over a thousand swordsmiths forged weapons under Feng Shixiong’s guidance.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375942</data>
      <data key="d6" />
    </node>
    <node id="Warring States Conflict">
      <data key="d0">Warring States Conflict</data>
      <data key="d1">event</data>
      <data key="d2">The struggle for dominance between Wu kingdom and northern states Qi and Jin involving military tactics and weaponry.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375943</data>
      <data key="d6" />
    </node>
    <node id="Wen Zhong">
      <data key="d0">Wen Zhong</data>
      <data key="d1">person</data>
      <data key="d2">An advisor summoned by King Goujian to discuss the difficult situation after the sword test.&lt;SEP&gt;Wen Zhong is another advisor alongside Fan Li and Goujian, engaged in discussing strategic affairs.&lt;SEP&gt;Wen Zhong is a political strategist who admires Fan Li's distinct views, leaves official duty to follow Fan Li to the State of Wu, and helps plan military and political strategies for the State of Yue.&lt;SEP&gt;Wen Zhong is an adviser who encourages sword casting and values the contributions of swordsmiths.&lt;SEP&gt;Wen Zhong is an adviser who reports about Ou Yezi’s disciples.&lt;SEP&gt;Wen Zhong is a visitor to Fan Li's estate, concerned about Fan Li’s unusual behavior and regarded Fan Li as a good friend.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e&lt;SEP&gt;chunk-bb8a415d6907f0cafb86835c412854f7&lt;SEP&gt;chunk-9f3e590b3ab7f94ee3770d3739196401&lt;SEP&gt;chunk-2a72fd2ce03a23a58c65d98d2258f3e1&lt;SEP&gt;chunk-9f20b87683fe0cc8608a321ff18feb71&lt;SEP&gt;chunk-c6f4631a6bc7286dd9560f06b9845d9e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375943</data>
      <data key="d6" />
    </node>
    <node id="Sword Making">
      <data key="d0">Sword Making</data>
      <data key="d1">concept</data>
      <data key="d2">The art and method of forging swords, involving ancient techniques and great effort as described in the forging of treasure swords.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375944</data>
      <data key="d6" />
    </node>
    <node id="Sharp Swords">
      <data key="d0">Sharp Swords</data>
      <data key="d1">artifact</data>
      <data key="d2">The large quantity of finely forged swords produced by Feng Shixiong and Wu Zixu to equip Wu soldiers.&lt;SEP&gt;Sharp Swords are the thousands of swords produced under Xue Zhu’s supervision as ordered by Fan Li.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e&lt;SEP&gt;chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375944</data>
      <data key="d6" />
    </node>
    <node id="Wu Soldiers">
      <data key="d0">Wu Soldiers</data>
      <data key="d1">person</data>
      <data key="d2">Wu Soldiers are the military forces of the Wu Kingdom, equipped with the sharp swords forged under Feng Shixiong’s supervision.</data>
      <data key="d3">chunk-3b2a680eed881fd86d938031d895d21e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375945</data>
      <data key="d6" />
    </node>
    <node id="White Ape">
      <data key="d0">White Ape</data>
      <data key="d1">creature</data>
      <data key="d2">The White Ape is a powerful non-human opponent wielding a bamboo stick, engaging in fast and skillful combat with A Qing.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375946</data>
      <data key="d6" />
    </node>
    <node id="Wu Kingdom Swordsmen">
      <data key="d0">Wu Kingdom Swordsmen</data>
      <data key="d1">organization</data>
      <data key="d2">The Wu Kingdom Swordsmen are warriors from Wu Kingdom who previously fought with A Qing and one was blinded by her in combat.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375946</data>
      <data key="d6" />
    </node>
    <node id="Yue Kingdom Swordsmen">
      <data key="d0">Yue Kingdom Swordsmen</data>
      <data key="d1">organization</data>
      <data key="d2">The Yue Kingdom Swordsmen are elite sword fighters who failed to withstand A Qing’s bamboo staff skill but witnessed her influence on sword techniques.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375946</data>
      <data key="d6" />
    </node>
    <node id="Kuaiji City">
      <data key="d0">Kuaiji City</data>
      <data key="d1">location</data>
      <data key="d2">Kuaiji City is an area where Fan Li’s men searched extensively for the missing A Qing.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375947</data>
      <data key="d6" />
    </node>
    <node id="God Sword Technique">
      <data key="d0">God Sword Technique</data>
      <data key="d1">concept</data>
      <data key="d2">The God Sword Technique is a remarkable and nearly unbeatable sword fighting style inspired by A Qing’s bamboo staff technique and spread among Yue swordsmen.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375947</data>
      <data key="d6" />
    </node>
    <node id="Five Lakes">
      <data key="d0">Five Lakes</data>
      <data key="d1">location</data>
      <data key="d2">The Five Lakes is the battlefield where Goujian’s army fought against Wu.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375948</data>
      <data key="d6" />
    </node>
    <node id="Yue Army">
      <data key="d0">Yue Army</data>
      <data key="d1">organization</data>
      <data key="d2">The Yue Army is led by Goujian and fought at the Five Lakes battle with a force of five thousand soldiers.&lt;SEP&gt;The military force of Yue, numbering 5,000, that advanced with long swords at the Battle of Wuhu.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084&lt;SEP&gt;chunk-f89960ee186e8b69358a7a5c384a3ee9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375948</data>
      <data key="d6" />
    </node>
    <node id="Bamboo Staff">
      <data key="d0">Bamboo Staff</data>
      <data key="d1">artifact</data>
      <data key="d2">The Bamboo Staff is a weapon used by A Qing and the White Ape in their combat, characterized by swift and skillful maneuvers and strikes.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375949</data>
      <data key="d6" />
    </node>
    <node id="Small Girl">
      <data key="d0">Small Girl</data>
      <data key="d1">person</data>
      <data key="d2">The Small Girl refers to A Qing, who disappeared leaving behind an empty house and about a dozen goats.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375949</data>
      <data key="d6" />
    </node>
    <node id="Goats">
      <data key="d0">Goats</data>
      <data key="d1">creature</data>
      <data key="d2">A group of about a dozen goats remained in A Qing’s empty house after her disappearance.</data>
      <data key="d3">chunk-e93cef7b7f368309937f9f274b9ad084</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375950</data>
      <data key="d6" />
    </node>
    <node id="Wu Country Swordsman">
      <data key="d0">Wu Country Swordsman</data>
      <data key="d1">person</data>
      <data key="d2">A swordsman from Wu Country who leads a group of eight swordsmen and demonstrates superior swordsmanship, including slicing a goat in two and engaging in conflict with guards and a young girl.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375950</data>
      <data key="d6" />
    </node>
    <node id="Guard">
      <data key="d0">Guard</data>
      <data key="d1">person</data>
      <data key="d2">Guards under Fan Li's command who are armed with swords and protect their lord, they surround and confront the Wu Country swordsmen.&lt;SEP&gt;The Guard is ordered by Fan Li to sew Lao Bai’s body and bury it beside A Qing’s house.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4&lt;SEP&gt;chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375951</data>
      <data key="d6" />
    </node>
    <node id="Young Girl">
      <data key="d0">Young Girl</data>
      <data key="d1">person</data>
      <data key="d2">A slender young girl wearing a light green garment who drives a herd of mountain goats and defends herself skillfully with a bamboo stick against Wu Country swordsmen.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375952</data>
      <data key="d6" />
    </node>
    <node id="Mountain Goats">
      <data key="d0">Mountain Goats</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A herd of dozen or so mountain goats being herded by the young girl through the street where the Wu Country swordsmen stand.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375952</data>
      <data key="d6" />
    </node>
    <node id="Gusu">
      <data key="d0">Gusu</data>
      <data key="d1">location</data>
      <data key="d2">Gusu is the originating place of the Wu Country swordsmen before traveling to Kuaiji.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375953</data>
      <data key="d6" />
    </node>
    <node id="Kuaiji">
      <data key="d0">Kuaiji</data>
      <data key="d1">location</data>
      <data key="d2">Kuaiji is the location where the Wu Country swordsmen arrive and confront Fan Li's guards.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375953</data>
      <data key="d6" />
    </node>
    <node id="Wu Country Swordsmen Group">
      <data key="d0">Wu Country Swordsmen Group</data>
      <data key="d1">organization</data>
      <data key="d2">A group of eight swordsmen from Wu Country acting as envoys who challenge opposition despite expecting death.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375953</data>
      <data key="d6" />
    </node>
    <node id="Wu Country Swordsmen Leader">
      <data key="d0">Wu Country Swordsmen Leader</data>
      <data key="d1">person</data>
      <data key="d2">The leading swordsman among the eight Wu Country swordsmen who displays arrogance, sword skill, and leads the group in confrontation with Fan Li’s guards and the young girl.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375954</data>
      <data key="d6" />
    </node>
    <node id="Fan Chai">
      <data key="d0">Fan Chai</data>
      <data key="d1">person</data>
      <data key="d2">A ruler implied to be the overlord or superior of Wu Country, whose anger Fan Li wishes to avoid by not escalating the conflict.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375954</data>
      <data key="d6" />
    </node>
    <node id="Six Wu Country Swordsmen">
      <data key="d0">Six Wu Country Swordsmen</data>
      <data key="d1">person</data>
      <data key="d2">A subgroup of the Wu Country swordsmen who are surprised and angry during the conflict and react to the young girl's attacks.</data>
      <data key="d3">chunk-76f36e0abe52b904e30fbb2a78b9a4a4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375955</data>
      <data key="d6" />
    </node>
    <node id="Lao Bai">
      <data key="d0">Lao Bai</data>
      <data key="d1">creature</data>
      <data key="d2">Lao Bai is a sheep that was killed and its body severed, deeply mourned and cared for by A Qing.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375956</data>
      <data key="d6" />
    </node>
    <node id="Mother of A Qing">
      <data key="d0">Mother of A Qing</data>
      <data key="d1">person</data>
      <data key="d2">The mother of A Qing advises selling sheep for money but is unaware of Fan Li’s promise to provide rice and cloth.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375956</data>
      <data key="d6" />
    </node>
    <node id="Bai Gonggong">
      <data key="d0">Bai Gonggong</data>
      <data key="d1">person</data>
      <data key="d2">Bai Gonggong is an elderly man living in the mountains who plays with A Qing using bamboo sticks and is implied to have taught her martial arts skills.&lt;SEP&gt;Bai Gonggong is an elderly man who teaches a young countryside girl mysterious swordsmanship and can train warriors of Yue to defeat Wu.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40&lt;SEP&gt;chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375957</data>
      <data key="d6" />
    </node>
    <node id="The House">
      <data key="d0">The House</data>
      <data key="d1">location</data>
      <data key="d2">The house is Fan Li’s large residence where A Qing is invited to stay and where sheep are kept in the garden.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375957</data>
      <data key="d6" />
    </node>
    <node id="Garden">
      <data key="d0">Garden</data>
      <data key="d1">location</data>
      <data key="d2">The garden is part of Fan Li’s estate where a herd of goats eat various flowers under Fan Li’s observation.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375958</data>
      <data key="d6" />
    </node>
    <node id="Mountain">
      <data key="d0">Mountain</data>
      <data key="d1">location</data>
      <data key="d2">The mountain is where Bai Gonggong lives and where Fan Li and A Qing go to herd sheep.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375958</data>
      <data key="d6" />
    </node>
    <node id="Sheep Herd">
      <data key="d0">Sheep Herd</data>
      <data key="d1">creature</data>
      <data key="d2">The herd of sheep (and mountain goats) that A Qing takes care of and brings to Fan Li’s estate.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375959</data>
      <data key="d6" />
    </node>
    <node id="Rice">
      <data key="d0">Rice</data>
      <data key="d1">artifact</data>
      <data key="d2">Rice is a staple food that Fan Li promises to provide to A Qing’s family to replace income lost by not selling sheep.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375959</data>
      <data key="d6" />
    </node>
    <node id="Cloth">
      <data key="d0">Cloth</data>
      <data key="d1">artifact</data>
      <data key="d2">Cloth is material that Fan Li promises to send to A Qing’s family as support.</data>
      <data key="d3">chunk-8283a4a379ab2b74495b2a64a83b7b40</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375960</data>
      <data key="d6" />
    </node>
    <node id="Fan Fu">
      <data key="d0">Fan Fu</data>
      <data key="d1">person</data>
      <data key="d2">Fan Fu refers to Fan Li as a gentleman; he is mentioned indirectly through staff describing his mysterious behavior.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375960</data>
      <data key="d6" />
    </node>
    <node id="Chu Kingdom">
      <data key="d0">Chu Kingdom</data>
      <data key="d1">location</data>
      <data key="d2">Chu Kingdom is a state described as the current possessor of the Zhan Lu sword and the original recipient of three swords forged by Ou Yezi.&lt;SEP&gt;The Chu Kingdom is the region where Fan Li was called "Fan Madman" due to his unconventional behavior.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7&lt;SEP&gt;chunk-9f20b87683fe0cc8608a321ff18feb71</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375961</data>
      <data key="d6" />
    </node>
    <node id="Xiangfei">
      <data key="d0">Xiangfei</data>
      <data key="d1">person</data>
      <data key="d2">Xiangfei is a figure from Chu Kingdom folklore known as the Xiangfei and mountain ghost, described in Fan Li’s stories to A Qing.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375961</data>
      <data key="d6" />
    </node>
    <node id="Xishi">
      <data key="d0">Xishi</data>
      <data key="d1">person</data>
      <data key="d2">Xishi is a beautiful woman whom Fan Li has seen and describes in great detail, contrasting with Xiangfei.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375962</data>
      <data key="d6" />
    </node>
    <node id="Northern Direction">
      <data key="d0">Northern Direction</data>
      <data key="d1">location</data>
      <data key="d2">Northern direction is the orientation Fan Li looks toward when thinking about the beautiful woman in the Wu King’s palace in Gusu city.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375963</data>
      <data key="d6" />
    </node>
    <node id="Gusu City">
      <data key="d0">Gusu City</data>
      <data key="d1">location</data>
      <data key="d2">Gusu City is the location of the Wu King’s palace where the beautiful woman Xishi resides.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375963</data>
      <data key="d6" />
    </node>
    <node id="Wu King">
      <data key="d0">Wu King</data>
      <data key="d1">person</data>
      <data key="d2">Wu King is the ruler residing in Gusu city, possibly accompanied or contemplated by Xishi.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375964</data>
      <data key="d6" />
    </node>
    <node id="Green Shadow">
      <data key="d0">Green Shadow</data>
      <data key="d1">creature</data>
      <data key="d2">Green Shadow is a swift figure who suddenly appears and fiercely engages in combat with White Shadow near Fan Li.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375964</data>
      <data key="d6" />
    </node>
    <node id="White Shadow">
      <data key="d0">White Shadow</data>
      <data key="d1">creature</data>
      <data key="d2">White Shadow is a swift figure who arrives and fights Green Shadow; Bai Gonggong is associated with this figure.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375965</data>
      <data key="d6" />
    </node>
    <node id="Sheep Herding">
      <data key="d0">Sheep Herding</data>
      <data key="d1">activity</data>
      <data key="d2">Sheep herding is the activity Fan Li and A Qing engage in together in the mountains while waiting for Bai Gonggong.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375965</data>
      <data key="d6" />
    </node>
    <node id="Story of Xiangfei and Mountain Ghost">
      <data key="d0">Story of Xiangfei and Mountain Ghost</data>
      <data key="d1">content</data>
      <data key="d2">This story is told by Fan Li to A Qing, involving the folklore figures Xiangfei and the mountain ghost.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375966</data>
      <data key="d6" />
    </node>
    <node id="Staff">
      <data key="d0">Staff</data>
      <data key="d1">person</data>
      <data key="d2">Staff members serve under Fan Li and report his unusual behavior to Wen Zhong.</data>
      <data key="d3">chunk-bb8a415d6907f0cafb86835c412854f7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375966</data>
      <data key="d6" />
    </node>
    <node id="State Of Wu">
      <data key="d0">State Of Wu</data>
      <data key="d1">location</data>
      <data key="d2">The State of Wu is a powerful southeastern kingdom with a rising influence, ruled by King Fuchai and advised by Wu Zixu.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375966</data>
      <data key="d6" />
    </node>
    <node id="State Of Yue">
      <data key="d0">State Of Yue</data>
      <data key="d1">location</data>
      <data key="d2">The State of Yue is a neighboring kingdom to Wu, smaller in size but culturally similar, ruled by King Goujian.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375967</data>
      <data key="d6" />
    </node>
    <node id="King Goujian">
      <data key="d0">King Goujian</data>
      <data key="d1">person</data>
      <data key="d2">The King who tests the sword, expresses determination to defeat Fu Chai, and orders the swordsmen to leave after the demonstration.&lt;SEP&gt;King Goujian is the ruler of the State of Yue, initially defeated by Wu, later employing strategies of Wen Zhong and Fan Li to rebuild strength and seek revenge.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401&lt;SEP&gt;chunk-c6f4631a6bc7286dd9560f06b9845d9e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375968</data>
      <data key="d6" />
    </node>
    <node id="Shi Mai">
      <data key="d0">Shi Mai</data>
      <data key="d1">person</data>
      <data key="d2">Shi Mai is a general appointed by King Goujian who suffered a major defeat beside the Qiantang River.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375968</data>
      <data key="d6" />
    </node>
    <node id="Tai Zai Bo Pi">
      <data key="d0">Tai Zai Bo Pi</data>
      <data key="d1">person</data>
      <data key="d2">Tai Zai Bo Pi is a treacherous minister in King Fuchai's court, bribed by Yue to influence the Wu king.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375969</data>
      <data key="d6" />
    </node>
    <node id="King Fuchai">
      <data key="d0">King Fuchai</data>
      <data key="d1">person</data>
      <data key="d2">King Fuchai is the ruler of the State of Wu who ignored Wu Zixu's counsel, eventually making peace and releasing King Goujian before being manipulated.&lt;SEP&gt;The King of Wu who retreated to Yuhang Mountain after the defeat and eventually committed suicide.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401&lt;SEP&gt;chunk-f89960ee186e8b69358a7a5c384a3ee9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375969</data>
      <data key="d6" />
    </node>
    <node id="Nine Military Strategies">
      <data key="d0">Nine Military Strategies</data>
      <data key="d1">concept</data>
      <data key="d2">The Nine Military Strategies are a set of tactics devised by Wen Zhong to defeat Wu, including respect for divine forces, economic sabotage, political manipulation, and military preparation.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375970</data>
      <data key="d6" />
    </node>
    <node id="Respected Divine Forces">
      <data key="d0">Respected Divine Forces</data>
      <data key="d1">concept</data>
      <data key="d2">The first of the Nine Military Strategies involves honoring the heavens and spirits to strengthen King Goujian's resolve.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375970</data>
      <data key="d6" />
    </node>
    <node id="Lavish Gifts To Wu">
      <data key="d0">Lavish Gifts To Wu</data>
      <data key="d1">concept</data>
      <data key="d2">The second strategy involves sending large quantities of wealth to encourage Wu's decadence and reduce vigilance.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375971</data>
      <data key="d6" />
    </node>
    <node id="Grain Loan And Sabotage">
      <data key="d0">Grain Loan And Sabotage</data>
      <data key="d1">concept</data>
      <data key="d2">The third strategy is borrowing grain from Wu and returning inferior seed rice to cause famine.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375971</data>
      <data key="d6" />
    </node>
    <node id="Gifts Of Xi Shi And Zheng Dan">
      <data key="d0">Gifts Of Xi Shi And Zheng Dan</data>
      <data key="d1">concept</data>
      <data key="d2">The fourth strategy includes gifting beautiful women to distract King Fuchai and weaken his governance.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375972</data>
      <data key="d6" />
    </node>
    <node id="Building Lavish Palaces">
      <data key="d0">Building Lavish Palaces</data>
      <data key="d1">concept</data>
      <data key="d2">The fifth strategy involves inducing Wu to build extravagant palaces and towers to drain resources.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375972</data>
      <data key="d6" />
    </node>
    <node id="Bribery Of Officials">
      <data key="d0">Bribery Of Officials</data>
      <data key="d1">concept</data>
      <data key="d2">The sixth strategy bribed corrupt ministers in Wu to damage the state administration.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375973</data>
      <data key="d6" />
    </node>
    <node id="Sowing Discord Among Loyalists">
      <data key="d0">Sowing Discord Among Loyalists</data>
      <data key="d1">concept</data>
      <data key="d2">The seventh strategy aimed to cause internal strife in Wu, culminating in the forced suicide of Wu Zixu.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375973</data>
      <data key="d6" />
    </node>
    <node id="Stockpiling Supplies">
      <data key="d0">Stockpiling Supplies</data>
      <data key="d1">concept</data>
      <data key="d2">The eighth strategy involved accumulation of food and funds to strengthen Yue's capacity for war.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375974</data>
      <data key="d6" />
    </node>
    <node id="Weapon Manufacturing And Training">
      <data key="d0">Weapon Manufacturing And Training</data>
      <data key="d1">concept</data>
      <data key="d2">The ninth strategy is making weapons and training soldiers to prepare for attack on Wu.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375974</data>
      <data key="d6" />
    </node>
    <node id="Wu Swordsmen">
      <data key="d0">Wu Swordsmen</data>
      <data key="d1">person</data>
      <data key="d2">Wu swordsmen are highly skilled fighters whose swordsmanship and group tactics are superior to Yue's soldiers.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375975</data>
      <data key="d6" />
    </node>
    <node id="Sun Wuzi">
      <data key="d0">Sun Wuzi</data>
      <data key="d1">person</data>
      <data key="d2">Sun Wuzi is the ancient military strategist who assisted the King of Wu and developed tactics used effectively in battles against Chu and other states.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375975</data>
      <data key="d6" />
    </node>
    <node id="Gan Jiang And Mo Ye">
      <data key="d0">Gan Jiang And Mo Ye</data>
      <data key="d1">person</data>
      <data key="d2">Gan Jiang and Mo Ye were a couple renowned for their exceptional sword forging skills in Wu.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375976</data>
      <data key="d6" />
    </node>
    <node id="Ou Yezi">
      <data key="d0">Ou Yezi</data>
      <data key="d1">person</data>
      <data key="d2">Ou Yezi was a master swordsmith from Yue whose sword forging craftsmanship rivaled that of Gan Jiang and Mo Ye.&lt;SEP&gt;Ou Yezi is a master swordsmith of Yue, famed for his sword-making skills, contemporary with Gan Jiang and Mo Ye.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401&lt;SEP&gt;chunk-9f20b87683fe0cc8608a321ff18feb71</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375976</data>
      <data key="d6" />
    </node>
    <node id="Battle By The Qiantang River">
      <data key="d0">Battle By The Qiantang River</data>
      <data key="d1">event</data>
      <data key="d2">A significant battle between Yue and Wu near the Qiantang River resulting in heavy defeat for Yue and King Goujian's near destruction.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375976</data>
      <data key="d6" />
    </node>
    <node id="Kuaiji Mountain">
      <data key="d0">Kuaiji Mountain</data>
      <data key="d1">location</data>
      <data key="d2">Kuaiji Mountain is the location where King Goujian was besieged after Yue's defeat in battle.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375977</data>
      <data key="d6" />
    </node>
    <node id="Zheng Dan">
      <data key="d0">Zheng Dan</data>
      <data key="d1">person</data>
      <data key="d2">Zheng Dan is a beautiful woman gifted alongside Xi Shi to King Fuchai as part of Yue’s political distraction strategy.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375977</data>
      <data key="d6" />
    </node>
    <node id="Sword Of Gan Jiang And Mo Ye">
      <data key="d0">Sword Of Gan Jiang And Mo Ye</data>
      <data key="d1">artifact</data>
      <data key="d2">The swords forged by the renowned couple Gan Jiang and Mo Ye, celebrated for their exceptional craftsmanship in the State of Wu.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375978</data>
      <data key="d6" />
    </node>
    <node id="Eu Yezi Sword">
      <data key="d0">Eu Yezi Sword</data>
      <data key="d1">artifact</data>
      <data key="d2">The sword crafted by Ou Yezi, a master swordsmith of Yue, whose forging skills rivaled those of Gan Jiang and Mo Ye.</data>
      <data key="d3">chunk-9f3e590b3ab7f94ee3770d3739196401</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375979</data>
      <data key="d6" />
    </node>
    <node id="Yue Nu Jian">
      <data key="d0">Yue Nu Jian</data>
      <data key="d1">content</data>
      <data key="d2">Yue Nu Jian is the name of the narrative or story depicted, featuring a sword duel between martial characters.</data>
      <data key="d3">chunk-c903f2e907674391708383e3d1afe7fb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375979</data>
      <data key="d6" />
    </node>
    <node id="Blue-Clothed Swordsman">
      <data key="d0">Blue-Clothed Swordsman</data>
      <data key="d1">person</data>
      <data key="d2">The Blue-Clothed Swordsman is a skilled fighter with a scarred face and experienced in many battles, using a long sword in combat during the duel.</data>
      <data key="d3">chunk-c903f2e907674391708383e3d1afe7fb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1777375980</data>
      <data key="d6" />
    </node>
    <node id="Brocade-Robed Swordsman">
      <data key="d0">Brocade-Robed Swordsman</data>
      <data key="d1">person</data>
      <data key="d2">The Brocade-Robed Swordsman is agile and quick, known for evading and counterattacking in a sword duel, who faces the Blue-Clothed Swordsman.&lt;SEP&gt;A swordsman who attempts to strike Fan Li but whose sword is cut in half by Fan Li’s quick move.</data>
